<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnsoft.device.api.res.mapper.DeviceAttachMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="deviceAttachResultMap" type="com.lnsoft.device.api.res.entity.DeviceAttach">
        <id column="id" property="id"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="filing_no" property="filingNo"/>
        <result column="business_type" property="businessType"/>
        <result column="file_type" property="fileType"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_path_mobile" property="filePathMobile"/>
        <result column="file_size" property="fileSize"/>
        <result column="remark" property="remark"/>
    </resultMap>


    <select id="selectDeviceAttachPage" resultMap="deviceAttachResultMap">
        select * from idevelop_device_attach where is_deleted = 0
    </select>

</mapper>
