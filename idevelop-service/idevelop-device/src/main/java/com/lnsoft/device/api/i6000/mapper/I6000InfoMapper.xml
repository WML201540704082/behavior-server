<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnsoft.device.api.i6000.mapper.I6000InfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="i6000InfoResultMap" type="com.lnsoft.device.api.i6000.entity.I6000Info">
        <result column="ci_code" property="ciCode"/>
        <result column="request" property="request"/>
        <result column="request_attr" property="requestAttr"/>
        <result column="response" property="response"/>
    </resultMap>


    <select id="selectI6000InfoPage" resultMap="i6000InfoResultMap">
        select * from idevelop_i6000_info where is_deleted = 0
    </select>

</mapper>
