<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnsoft.device.api.operation.mapper.DeviceChangeLogsMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="deviceChangeLogsResultMap" type="com.lnsoft.device.api.operation.entity.DeviceChangeLogs">
        <id column="id" property="id"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="attribute_name" property="attributeName"/>
        <result column="change_before" property="changeBefore"/>
        <result column="change_after" property="changeAfter"/>
        <result column="change_code" property="changeCode"/>
        <result column="device_code" property="deviceCode"/>
        <result column="remark" property="remark"/>
        <result column="attribute_code" property="attributeCode"/>
    </resultMap>
    <delete id="deleteByDevOrChange">
        delete from idevelop_device_change_logs where change_id = #{changeId}
    </delete>
    <delete id="deleteOne">
        delete from idevelop_device_change_logs where id = #{id}
    </delete>


    <select id="selectDeviceChangeLogsPage" resultMap="deviceChangeLogsResultMap">
        select * from idevelop_device_change_logs where is_deleted = 0
    </select>

</mapper>
