<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnsoft.device.api.cmdb.mapper.TripleApiLogMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="tripleApiLogResultMap" type="com.lnsoft.device.api.cmdb.entity.TripleApiLog">
        <result column="is_deleted" property="isDeleted"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="status" property="status"/>
        <result column="id" property="id"/>
        <result column="value" property="value"/>
        <result column="triple_type" property="tripleType"/>
        <result column="text" property="text"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="class_name" property="className"/>
        <result column="method_name" property="methodName"/>
        <result column="ip" property="ip"/>
        <result column="result" property="result"/>
        <result column="region_code" property="regionCode"/>
        <result column="region_name" property="regionName"/>
        <result column="success" property="success"/>
    </resultMap>


    <select id="selectTripleApiLogPage" resultMap="tripleApiLogResultMap">
        select * from idevelop_triple_api_log where is_deleted = 0
    </select>

</mapper>
