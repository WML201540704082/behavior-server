<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnsoft.device.api.warehouse.mapper.CheckTaskRemindMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="checkTaskRemindResultMap" type="com.lnsoft.device.api.warehouse.entity.CheckTaskRemind">
        <id column="id" property="id"/>
        <result column="status" property="status"/>
        <result column="create_user" property="createUser"/>
        <result column="create_dept" property="createDept"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user" property="updateUser"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="task_name" property="taskName"/>
        <result column="task_start_time" property="taskStartTime"/>
        <result column="task_end_time" property="taskEndTime"/>
        <result column="user" property="user"/>
        <result column="user_id" property="userId"/>
        <result column="remark" property="remark"/>
    </resultMap>


    <select id="selectCheckTaskRemindPage" resultMap="checkTaskRemindResultMap">
        select * from idevelop_check_task_remind where is_deleted = 0
        AND user_id = #{checkTaskRemind.userId}
        <if test="checkTaskRemind.status != null and checkTaskRemind.status != ''">
            AND status =#{checkTaskRemind.status}
        </if>
    </select>

</mapper>
